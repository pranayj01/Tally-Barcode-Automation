;; ============================================================================
;; 01_udf.tdl — Company sequence + Stock Item print preference
;;
;; ARCHITECTURE:
;;   Barcode storage = native Stock Item Alias ONLY.
;;   JGLabelsToPrint = manual override for Stock Item reprint count
;;   (editable on master in Create/Alter — not a Display popup).
;;
;; Indexes 21100–21103 reserved for JG Barcode Add-on
;; ============================================================================

[System: UDF]
    JGNextSeq       : Number : 21100
    JGHighestIssued : Number : 21101
    JGSequenceYear  : Number : 21102
    ;; Stock Item: how many labels when reprinting from master
    JGLabelsToPrint : Number : 21103
