;; ============================================================================
;; StockItemFields.tdl — Stock Item UDFs + master screen fields
;; ============================================================================

[System: UDF]
    JGBarcode             : String   : 21001
    JGManufacturerBarcode : String   : 21002
    JGBarcodeEncoded      : String   : 21003
    JGBrand               : String   : 21004
    JGCategory            : String   : 21005
    JGSize                : String   : 21006
    JGColour              : String   : 21007
    JGHsn                 : String   : 21008
    JGGstRate             : Number   : 21009
    JGPurchaseRate        : Amount   : 21010
    JGMrp                 : Amount   : 21011
    JGSellingRate         : Amount   : 21012
    JGOpeningQty          : Quantity : 21013
    ;; When barcode was assigned (audit)
    JGBarcodeAssignedOn   : Date     : 21014

[Part: JG Stock Item Barcode Part]
    Lines         : JG SI Title, JG SI Barcode Line, JG SI Mfr Line, JG SI Attr1, JG SI Attr2, JG SI Rates
    Scroll        : Vertical
    Common Border : Yes

[Line: JG SI Title]
    Fields : JG SI Title Fld

[Field: JG SI Title Fld]
    Use    : Name Field
    Set As : "JG Barcode Details"
    Style  : Normal Bold
    Align  : Centre
    Width  : 100% Page

[Line: JG SI Barcode Line]
    Fields : JG Lbl Barcode, JG Fld Barcode, JG Lbl Encoded Hint

[Field: JG Lbl Barcode]
    Use    : Name Field
    Set As : "Barcode"
    Width  : 18
    Style  : Normal Bold

[Field: JG Fld Barcode]
    Use      : Name Field
    Storage  : JGBarcode
    Width    : 22
    ;; Permanent once assigned — do not edit casually
    Inactive : NOT $$IsEmpty:$JGBarcode

[Field: JG Lbl Encoded Hint]
    Use    : Name Field
    Set As : IF $$IsEmpty:$JGBarcode THEN "Will auto-generate on Purchase" ELSE "Locked (never reused)"
    Width  : 40
    Color  : IF $$IsEmpty:$JGBarcode THEN "Blue" ELSE "Forest Green"

[Line: JG SI Mfr Line]
    Fields : JG Lbl Mfr, JG Fld Mfr

[Field: JG Lbl Mfr]
    Use    : Name Field
    Set As : "Manufacturer Barcode"
    Width  : 18

[Field: JG Fld Mfr]
    Use     : Name Field
    Storage : JGManufacturerBarcode
    Width   : 30

[Line: JG SI Attr1]
    Fields : JG Lbl Brand, JG Fld Brand, JG Lbl Cat, JG Fld Cat

[Field: JG Lbl Brand]
    Use : Name Field
    Set As : "Brand"
    Width : 10

[Field: JG Fld Brand]
    Use : Name Field
    Storage : JGBrand
    Width : 18

[Field: JG Lbl Cat]
    Use : Name Field
    Set As : "Category"
    Width : 10

[Field: JG Fld Cat]
    Use : Name Field
    Storage : JGCategory
    Width : 18

[Line: JG SI Attr2]
    Fields : JG Lbl Size, JG Fld Size, JG Lbl Colour, JG Fld Colour, JG Lbl HSN, JG Fld HSN

[Field: JG Lbl Size]
    Use : Name Field
    Set As : "Size"
    Width : 8

[Field: JG Fld Size]
    Use : Name Field
    Storage : JGSize
    Width : 10

[Field: JG Lbl Colour]
    Use : Name Field
    Set As : "Colour"
    Width : 8

[Field: JG Fld Colour]
    Use : Name Field
    Storage : JGColour
    Width : 12

[Field: JG Lbl HSN]
    Use : Name Field
    Set As : "HSN"
    Width : 6

[Field: JG Fld HSN]
    Use : Name Field
    Storage : JGHsn
    Width : 12

[Line: JG SI Rates]
    Fields : JG Lbl MRP, JG Fld MRP, JG Lbl Sell, JG Fld Sell, JG Lbl Pur, JG Fld Pur

[Field: JG Lbl MRP]
    Use : Name Field
    Set As : "MRP"
    Width : 8
    Style : Normal Bold

[Field: JG Fld MRP]
    Use : Amount Field
    Storage : JGMrp
    Width : 12

[Field: JG Lbl Sell]
    Use : Name Field
    Set As : "Selling Rate"
    Width : 12
    Style : Normal Bold

[Field: JG Fld Sell]
    Use : Amount Field
    Storage : JGSellingRate
    Width : 12

[Field: JG Lbl Pur]
    Use : Name Field
    Set As : "Purchase Rate"
    Width : 12

[Field: JG Fld Pur]
    Use : Amount Field
    Storage : JGPurchaseRate
    Width : 12

;; Attach barcode fields to the standard Stock Item master form (TallyPrime)
[#Form: Stock Item]
    Add : Part : JG Stock Item Barcode Part

[Function: JG Persist Item Barcode]
    Parameter : pItem : String
    Parameter : pBarcode : String
    Parameter : pMfr : String
    Variable  : Enc : String
    01 : IF : $$IsEmpty:##pItem OR $$IsEmpty:##pBarcode
    02 :   RETURN : No
    03 : ENDIF
    04 : Set : Enc : $$Call:JG Code128 Encode Safe:##pBarcode
    05 : New Object : Stock Item : ##pItem
    06 : Set Value  : JGBarcode : ##pBarcode
    07 : Set Value  : JGBarcodeEncoded : ##Enc
    08 : IF : NOT $$IsEmpty:##pMfr
    09 :   Set Value : JGManufacturerBarcode : ##pMfr
    10 : ENDIF
    11 : Set Value : JGBarcodeAssignedOn : $$MachineDate
    12 : Accept Alter
    13 : RETURN : Yes

[Function: JG Get Item Barcode]
    Parameter : pItem : String
    01 : RETURN : $JGBarcode:StockItem:##pItem

[Function: JG Get Item MfrBarcode]
    Parameter : pItem : String
    01 : RETURN : $JGManufacturerBarcode:StockItem:##pItem
