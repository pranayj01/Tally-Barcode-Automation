;; ============================================================================
;; 99_alias_write_probe.tdl — TEMPORARY live probe (granular)
;;
;; Confirmed so far:
;;   Ping OK
;;   Read OK — $$Alias = [XMLPROBE001] in Stock Item context
;;   Write probes stop AFTER Step 2 (before Step 3) =
;;     failure inside New Object / Set Value / Accept Alter
;;
;; This revision MsgBoxes between each write action.
;; Also adds Name-collection insert probe (manual-style Name list).
;; ============================================================================

[Collection: JGProbeItemColl]
    Type   : Stock Item
    Filter : JGProbeItemFilter

[System: Formula]
    JGProbeItemFilter : $Name = "NEW TEST 1"

[Function: JG Probe Ping]
    01 : MSG BOX : "Probe" : "Menu Call works."

[Function: JG Probe Read]
    Variable : Code : String
    01 : Set : Code : ""
    02 : Walk Collection : JGProbeItemColl
    03 :   Set : Code : $$Alias
    04 : End Walk
    05 : MSG BOX : "Probe Read" : "$$Alias = [" + ##Code + "]"
    06 : RETURN : ##Code

[Function: JG Probe FirstAlias]
    Variable : Before : String
    Variable : After : String
    01 : Call : JG Probe Read
    02 : Set : Before : $$LastResult
    03 : MSG BOX : "FirstAlias" : "A — before New Object. before=[" + ##Before + "]"
    04 : New Object : Stock Item : "NEW TEST 1"
    05 : MSG BOX : "FirstAlias" : "B — after New Object, before Set Value FirstAlias"
    06 : Set Value  : FirstAlias : "SETVAL_FIRSTALIAS"
    07 : MSG BOX : "FirstAlias" : "C — after Set Value FirstAlias, before Accept Alter"
    08 : Accept Alter
    09 : MSG BOX : "FirstAlias" : "D — after Accept Alter, reading back..."
    10 : Call : JG Probe Read
    11 : Set : After : $$LastResult
    12 : MSG BOX : "FirstAlias RESULT" : "Before=[" + ##Before + "] After=[" + ##After + "] Expected=SETVAL_FIRSTALIAS"

[Function: JG Probe Alias]
    Variable : Before : String
    Variable : After : String
    01 : Call : JG Probe Read
    02 : Set : Before : $$LastResult
    03 : MSG BOX : "Alias" : "A — before New Object. before=[" + ##Before + "]"
    04 : New Object : Stock Item : "NEW TEST 1"
    05 : MSG BOX : "Alias" : "B — after New Object, before Set Value Alias"
    06 : Set Value  : Alias : "SETVAL_ALIAS"
    07 : MSG BOX : "Alias" : "C — after Set Value Alias, before Accept Alter"
    08 : Accept Alter
    09 : MSG BOX : "Alias" : "D — after Accept Alter, reading back..."
    10 : Call : JG Probe Read
    11 : Set : After : $$LastResult
    12 : MSG BOX : "Alias RESULT" : "Before=[" + ##Before + "] After=[" + ##After + "] Expected=SETVAL_ALIAS"

;; Manual p.475 style: INSERT COLLECTION OBJECT : Name then SET VALUE : Name
;; (second Name entry is how Alias appears in XML NAME.LIST)
[Function: JG Probe NameInsert]
    Variable : Before : String
    Variable : After : String
    01 : Call : JG Probe Read
    02 : Set : Before : $$LastResult
    03 : MSG BOX : "NameInsert" : "A — before New Object. before=[" + ##Before + "]"
    04 : New Object : Stock Item : "NEW TEST 1"
    05 : MSG BOX : "NameInsert" : "B — after New Object, before INSERT Name"
    06 : Insert Collection Object : Name
    07 : MSG BOX : "NameInsert" : "C — after INSERT Name, before Set Value Name"
    08 : Set Value : Name : "SETVAL_NAMEINSERT"
    09 : MSG BOX : "NameInsert" : "D — after Set Value Name, before Accept Alter"
    10 : Accept Alter
    11 : MSG BOX : "NameInsert" : "E — after Accept Alter, reading back..."
    12 : Call : JG Probe Read
    13 : Set : After : $$LastResult
    14 : MSG BOX : "NameInsert RESULT" : "Before=[" + ##Before + "] After=[" + ##After + "] Expected=SETVAL_NAMEINSERT"

[#Menu: Gateway of Tally]
    Add : Item : Before : @@LocQuit : JG Probe Ping : Call : JG Probe Ping
    Add : Item : Before : @@LocQuit : JG Probe Read Alias : Call : JG Probe Read
    Add : Item : Before : @@LocQuit : JG Probe FirstAlias Write : Call : JG Probe FirstAlias
    Add : Item : Before : @@LocQuit : JG Probe Alias Write : Call : JG Probe Alias
    Add : Item : Before : @@LocQuit : JG Probe NameInsert Write : Call : JG Probe NameInsert
