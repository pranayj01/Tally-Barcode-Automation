[#Form: JGLabelForm]
    Delete : Part : JGLabelPart
    Add    : Part : JGSheetPart
    Width  : 210 mm
    Height : 297 mm

[Part: JGSheetPart]
    Parts      : JGSheetRow01, JGSheetRow02, JGSheetRow03, JGSheetRow04, JGSheetRow05, JGSheetRow06, JGSheetRow07, JGSheetRow08, JGSheetRow09, JGSheetRow10, JGSheetRow11, JGSheetRow12, JGSheetRow13, JGSheetRow14, JGSheetRow15, JGSheetRow16, JGSheetRow17, JGSheetRow18, JGSheetRow19, JGSheetRow20, JGSheetRow21, JGSheetRow22, JGSheetRow23, JGSheetRow24, JGSheetRow25, JGSheetRow26, JGSheetRow27, JGSheetRow28, JGSheetRow29, JGSheetRow30, JGSheetRow31, JGSheetRow32, JGSheetRow33, JGSheetRow34
    Vertical   : Yes
    Space Top  : 5 mm
    Space Left : 5 mm

;; ---- Row 1 (labels 1-3) ----
[Part: JGSheetRow01]
    Parts        : JGSticker0101, JGSticker0102, JGSticker0103
    Vertical     : No
    Height       : 40 mm
    Space Bottom : 3 mm
    Invisible    : @@JGHideCopy001

[Part: JGSticker0101]
    Use        : JGLabelPart
    Width      : 60 mm
    Height     : 40 mm
    Invisible  : @@JGHideCopy001

[Part: JGSticker0102]
    Use        : JGLabelPart
    Width      : 60 mm
    Height     : 40 mm
