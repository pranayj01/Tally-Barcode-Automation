;; ============================================================================
;; 08_templates.tdl — A4: 3 cols x 5 rows (HARDCODED sizes)
;;
;; Safe IF/THEN mm formulas caused Bad formula! — sizes fixed for now.
;; Copies/start-from/per-row still use ##JG* (comparisons only, no mm).
;; ============================================================================

[System: Formula]
    JGLastPrintSlot : $$Number:##JGStartFromLabel + $$Number:##JGLabelsToPrint - 1

    JGInactive01 : IF ($$Number:##JGLabelsPerRow < 1) OR ($$Number:##JGStartFromLabel > 1) OR ($$Number:@@JGLastPrintSlot < 1) THEN Yes ELSE No
    JGInactive02 : IF ($$Number:##JGLabelsPerRow < 2) OR ($$Number:##JGStartFromLabel > 2) OR ($$Number:@@JGLastPrintSlot < 2) THEN Yes ELSE No
    JGInactive03 : IF ($$Number:##JGLabelsPerRow < 3) OR ($$Number:##JGStartFromLabel > 3) OR ($$Number:@@JGLastPrintSlot < 3) THEN Yes ELSE No
    JGInactive04 : IF ($$Number:##JGLabelsPerRow < 1) OR ($$Number:##JGStartFromLabel > 4) OR ($$Number:@@JGLastPrintSlot < 4) THEN Yes ELSE No
    JGInactive05 : IF ($$Number:##JGLabelsPerRow < 2) OR ($$Number:##JGStartFromLabel > 5) OR ($$Number:@@JGLastPrintSlot < 5) THEN Yes ELSE No
    JGInactive06 : IF ($$Number:##JGLabelsPerRow < 3) OR ($$Number:##JGStartFromLabel > 6) OR ($$Number:@@JGLastPrintSlot < 6) THEN Yes ELSE No
    JGInactive07 : IF ($$Number:##JGLabelsPerRow < 1) OR ($$Number:##JGStartFromLabel > 7) OR ($$Number:@@JGLastPrintSlot < 7) THEN Yes ELSE No
    JGInactive08 : IF ($$Number:##JGLabelsPerRow < 2) OR ($$Number:##JGStartFromLabel > 8) OR ($$Number:@@JGLastPrintSlot < 8) THEN Yes ELSE No
    JGInactive09 : IF ($$Number:##JGLabelsPerRow < 3) OR ($$Number:##JGStartFromLabel > 9) OR ($$Number:@@JGLastPrintSlot < 9) THEN Yes ELSE No
    JGInactive10 : IF ($$Number:##JGLabelsPerRow < 1) OR ($$Number:##JGStartFromLabel > 10) OR ($$Number:@@JGLastPrintSlot < 10) THEN Yes ELSE No
    JGInactive11 : IF ($$Number:##JGLabelsPerRow < 2) OR ($$Number:##JGStartFromLabel > 11) OR ($$Number:@@JGLastPrintSlot < 11) THEN Yes ELSE No
    JGInactive12 : IF ($$Number:##JGLabelsPerRow < 3) OR ($$Number:##JGStartFromLabel > 12) OR ($$Number:@@JGLastPrintSlot < 12) THEN Yes ELSE No
    JGInactive13 : IF ($$Number:##JGLabelsPerRow < 1) OR ($$Number:##JGStartFromLabel > 13) OR ($$Number:@@JGLastPrintSlot < 13) THEN Yes ELSE No
    JGInactive14 : IF ($$Number:##JGLabelsPerRow < 2) OR ($$Number:##JGStartFromLabel > 14) OR ($$Number:@@JGLastPrintSlot < 14) THEN Yes ELSE No
    JGInactive15 : IF ($$Number:##JGLabelsPerRow < 3) OR ($$Number:##JGStartFromLabel > 15) OR ($$Number:@@JGLastPrintSlot < 15) THEN Yes ELSE No

[#Form: JGLabelForm]
    Delete : Part : JGLabelPart
    Add    : Part : JGSheetPart
    Width  : 210 mm
    Height : 297 mm

[Part: JGSheetPart]
    Parts      : JGSheetRow1, JGSheetRow2, JGSheetRow3, JGSheetRow4, JGSheetRow5
    Vertical   : Yes
    Space Top  : 5 mm
    Space Left : 5 mm

;; ---- Row 1 ----
[Part: JGSheetRow1]
    Parts        : JGSticker11, JGSticker12, JGSticker13
    Vertical     : No
    Height       : 40 mm
    Space Bottom : 3 mm

[Part: JGSticker11]
    Use        : JGLabelPart
    Width      : 60 mm
    Height     : 40 mm
    Local : Field : JGLabelBarsFld : Inactive : @@JGInactive01
    Local : Field : JGLabelAliasFld : Inactive : @@JGInactive01
    Local : Field : JGLabelNameFld : Inactive : @@JGInactive01
    Local : Field : JGLabelMrpFld : Inactive : @@JGInactive01
    Local : Field : JGLabelRateFld : Inactive : @@JGInactive01

[Part: JGSticker12]
    Use        : JGLabelPart
    Width      : 60 mm
    Height     : 40 mm
    Space Left : 3 mm
    Local : Field : JGLabelBarsFld : Inactive : @@JGInactive02
    Local : Field : JGLabelAliasFld : Inactive : @@JGInactive02
    Local : Field : JGLabelNameFld : Inactive : @@JGInactive02
    Local : Field : JGLabelMrpFld : Inactive : @@JGInactive02
    Local : Field : JGLabelRateFld : Inactive : @@JGInactive02

[Part: JGSticker13]
    Use        : JGLabelPart
    Width      : 60 mm
    Height     : 40 mm
    Space Left : 3 mm
    Local : Field : JGLabelBarsFld : Inactive : @@JGInactive03
    Local : Field : JGLabelAliasFld : Inactive : @@JGInactive03
    Local : Field : JGLabelNameFld : Inactive : @@JGInactive03
    Local : Field : JGLabelMrpFld : Inactive : @@JGInactive03
    Local : Field : JGLabelRateFld : Inactive : @@JGInactive03

