;; ============================================================================
;; 08_templates.tdl — fixed 3-column A4 label layout
;;
;; Layout, sizes, gaps, margins and barcode rendering are unchanged.
;; Only visibility is controlled by ##JGPrintCopies (1..100).
;; Invisible Parts collapse to zero size, so no blank labels/rows follow.
;; ============================================================================

[System: Formula]
    JGHideCopy001 : $$Number:##JGPrintCopies < 1
    JGHideCopy002 : $$Number:##JGPrintCopies < 2
    JGHideCopy003 : $$Number:##JGPrintCopies < 3
    JGHideCopy004 : $$Number:##JGPrintCopies < 4
