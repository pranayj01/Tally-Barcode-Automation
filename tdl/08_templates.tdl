;; ============================================================================
;; 08_templates.tdl — A4 3-column sheet repeating over JGLabelRowColl
;;
;; JGPrintLabelQueue packs JGLabelQueue into rows of 3 (JGLabelRows).
;; This Form deletes the single-sticker Part and repeats one row Line
;; per packed row — one preview / one print job for the whole voucher.
;;
;; LAYOUT RULE: the three stickers of a row are FIELDS on the same Line.
;; Sub-Parts with "Vertical : No" rendered one below the other, so each
;; sticker text row is a Line carrying three 60 mm fields instead.
;;
;; Unused slots in the last row are blanked by their own Set As
;; (no "**" bars, no bare "MRP :" / "Rate :" labels).
;; ============================================================================

[#Form: JGLabelForm]
    Delete : Part : JGLabelPart
    Add    : Part : JGSheetPart
    Width  : 210 mm
    Height : 297 mm

[Part: JGSheetPart]
    Lines      : JGSheetRowLine
    Repeat     : JGSheetRowLine : JGLabelRowColl
    Vertical   : Yes
    Space Top  : 5 mm
    Space Left : 5 mm
    Scroll     : Vertical

;; Row = bars line (3 fields) + exploded part holding the 4 text lines.
;; Keeping the bars on this Line satisfies the "Line must have Fields" rule
;; without an empty anchor line between rows.
[Line: JGSheetRowLine]
    Fields       : JGBars1Fld, JGBars2Fld, JGBars3Fld
    Explode      : JGSheetRowPart
    Space Bottom : 3 mm

[Part: JGSheetRowPart]
    Lines    : JGRowAliasLine, JGRowNameLine, JGRowMrpLine, JGRowRateLine
    Vertical : Yes

[Line: JGRowAliasLine]
    Fields : JGAlias1Fld, JGAlias2Fld, JGAlias3Fld

[Line: JGRowNameLine]
    Fields : JGName1Fld, JGName2Fld, JGName3Fld

[Line: JGRowMrpLine]
    Fields : JGMrp1Fld, JGMrp2Fld, JGMrp3Fld

[Line: JGRowRateLine]
    Fields : JGRate1Fld, JGRate2Fld, JGRate3Fld

;; ---- Column 1 ----

[Field: JGBars1Fld]
    Use    : Name Field
    Set As : if $$IsEmpty:$A1 then "" else ("*" + $A1 + "*")
    Style  : JGLabelBarsStyle
    Width  : 60 mm
    Align  : Centre

[Field: JGAlias1Fld]
    Use    : Name Field
    Set As : $A1
    Style  : Tiny Bold
    Width  : 60 mm
    Align  : Centre

[Field: JGName1Fld]
    Use    : Name Field
    Set As : $$StringPart:$N1:0:24
    Style  : Tiny
    Width  : 60 mm
    Align  : Centre

[Field: JGMrp1Fld]
    Use    : Name Field
    Set As : if $$IsEmpty:$A1 then "" else ("MRP : " + $M1)
    Style  : Tiny
    Width  : 60 mm
    Align  : Centre

[Field: JGRate1Fld]
    Use    : Name Field
    Set As : if $$IsEmpty:$A1 then "" else ("Rate : " + $R1)
    Style  : Tiny
    Width  : 60 mm
    Align  : Centre

;; ---- Column 2 ----

[Field: JGBars2Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A2 then "" else ("*" + $A2 + "*")
    Style      : JGLabelBarsStyle
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGAlias2Fld]
    Use        : Name Field
    Set As     : $A2
    Style      : Tiny Bold
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGName2Fld]
    Use        : Name Field
    Set As     : $$StringPart:$N2:0:24
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGMrp2Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A2 then "" else ("MRP : " + $M2)
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGRate2Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A2 then "" else ("Rate : " + $R2)
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

;; ---- Column 3 ----

[Field: JGBars3Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A3 then "" else ("*" + $A3 + "*")
    Style      : JGLabelBarsStyle
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGAlias3Fld]
    Use        : Name Field
    Set As     : $A3
    Style      : Tiny Bold
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGName3Fld]
    Use        : Name Field
    Set As     : $$StringPart:$N3:0:24
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGMrp3Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A3 then "" else ("MRP : " + $M3)
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm

[Field: JGRate3Fld]
    Use        : Name Field
    Set As     : if $$IsEmpty:$A3 then "" else ("Rate : " + $R3)
    Style      : Tiny
    Width      : 60 mm
    Align      : Centre
    Space Left : 3 mm
