;; ============================================================================
;; ToolsMenu.tdl — Gateway tools (all native, no Node)
;; ============================================================================

[Report: JG Native Tools Report]
    Form  : JG Native Tools Form
    Title : "JG Barcode Tools"

[Form: JG Native Tools Form]
    Parts  : JG Native Tools Part
    Width  : 55% Screen
    Height : 55% Screen

[Part: JG Native Tools Part]
    Lines  : JG NT Title, JG NT Next, JG NT Reprint, JG NT Search, JG NT Batch, JG NT Font, JG NT Quit
    Scroll : Vertical

[Line: JG NT Title]
    Fields : JG NT Title Fld

[Field: JG NT Title Fld]
    Use   : Name Field
    Set As: "JG Barcode — Native Tally Add-on"
    Style : Large Bold
    Align : Centre
    Width : 100% Page

[Line: JG NT Next]
    Fields : JG NT Next Fld

[Field: JG NT Next Fld]
    Use    : Name Field
    Set As : "1. Show Next Barcode  →  " + $$Call:JG Peek Next Barcode
    Width  : 100% Page
    Key    : Enter
    Action : Call : JG Show Next Info

[Line: JG NT Reprint]
    Fields : JG NT Reprint Fld

[Field: JG NT Reprint Fld]
    Use    : Name Field
    Set As : "2. Reprint Label by Barcode"
    Width  : 100% Page
    Key    : Enter
    Action : Call : JG Tools Reprint

[Line: JG NT Search]
    Fields : JG NT Search Fld

[Field: JG NT Search Fld]
    Use    : Name Field
    Set As : "3. Search Item by Barcode"
    Width  : 100% Page
    Key    : Enter
    Action : Call : JG Tools Search

[Line: JG NT Batch]
    Fields : JG NT Batch Fld

[Field: JG NT Batch Fld]
    Use    : Name Field
    Set As : "4. Batch Print Labels (enter item name)"
    Width  : 100% Page
    Key    : Enter
    Action : Call : JG Tools Batch Print

[Line: JG NT Font]
    Fields : JG NT Font Fld

[Field: JG NT Font Fld]
    Use    : Name Field
    Set As : "5. Font Help (Code128 setup)"
    Width  : 100% Page
    Key    : Enter
    Action : Call : JG Font Help

[Line: JG NT Quit]
    Fields : JG NT Quit Fld

[Field: JG NT Quit Fld]
    Use    : Name Field
    Set As : "6. Back"
    Width  : 100% Page
    Key    : Enter
    Action : Form Accept

[Function: JG Show Next Info]
    Variable : N : String
    Variable : H : String
    01 : Call : JG Ensure Company Sequence
    02 : Set : N : $$Call:JG Peek Next Barcode
    03 : Set : H : $$String:$$Number:$JGHighestIssued:Company:##SVCurrentCompany
    04 : MSG BOX : "Sequence" : "Next barcode: " + ##N + $$LocalCRLF + "Highest issued: " + ##H + $$LocalCRLF + "Deleted codes are never reused."

[Function: JG Tools Reprint]
    01 : Input Value : "Barcode to reprint" : JGScanBuffer : String
    02 : IF : $$IsEmpty:##JGScanBuffer
    03 :   RETURN
    04 : ENDIF
    05 : Call : JG Reprint One : ##JGScanBuffer

[Function: JG Tools Search]
    Variable : Item : String
    01 : Input Value : "Scan / type barcode" : JGScanBuffer : String
    02 : Set : Item : $$Call:JG Resolve Barcode To Item:##JGScanBuffer
    03 : IF : $$IsEmpty:##Item
    04 :   MSG BOX : "Search" : "Not found"
    05 : ELSE
    06 :   MSG BOX : "Search" : "Item: " + ##Item + $$LocalCRLF + "Barcode: " + $JGBarcode:StockItem:##Item + $$LocalCRLF + "Mfr: " + $JGManufacturerBarcode:StockItem:##Item + $$LocalCRLF + "MRP: " + $$String:$JGMrp:StockItem:##Item + $$LocalCRLF + "Rate: " + $$String:$JGSellingRate:StockItem:##Item
    07 : ENDIF

[Function: JG Tools Batch Print]
    Variable : Item : String
    Variable : Copies : String
    01 : Input Value : "Stock Item Name" : JGWorkItem : String
    02 : Set : Item : ##JGWorkItem
    03 : IF : $$IsEmpty:##Item
    04 :   RETURN
    05 : ENDIF
    06 : IF : $$IsEmpty:$JGBarcode:StockItem:##Item
    07 :   MSG BOX : "Batch Print" : "Item has no barcode. Save a Purchase first or assign barcode."
    08 :   RETURN
    09 : ENDIF
    10 : Input Value : "Number of copies" : JGScanBuffer : String
    11 : Set : Copies : ##JGScanBuffer
    12 : IF : $$IsEmpty:##Copies
    13 :   Set : Copies : "1"
    14 : ENDIF
    15 : Set : JGLabelList : ##Item + "|" + ##Copies + "~"
    16 : Call : JG Print Label Queue

[Function: JG Font Help]
    01 : MSG BOX : "Code128 Font" : "1) Open folder fonts under this add-on" + $$LocalCRLF + "2) Install LibreBarcode128-Regular.ttf" + $$LocalCRLF + "3) Restart TallyPrime" + $$LocalCRLF + "4) Font name in Config: Libre Barcode 128" + $$LocalCRLF + "Printers: use Windows driver for TSC/Zebra/XPrinter/TVS"
