;; ============================================================================
;; 06_print_engine.tdl — Stock Item reprint launcher (no popup)
;;
;; Workflow A — Single item reprint:
;;   Edit "Labels to Print" on Stock Item master (Create/Alter + Storage)
;;   Ctrl+Alt+B → read that UDF → Print Report : JGLabelReport
;;
;; No Display config Report. No copies popup.
;; Layout still driven by ##JGPrintCopies (Module 08).
;;
;; Purchase qty printing lives in 04_purchase.tdl (calls JGLoadItemPrintPayload
;; and Print Report : JGLabelReport).
;; ============================================================================

[System: Variable]
    JGPrintAlias      : String
    JGPrintItemName   : String
    JGPrintMRP        : String
    JGPrintRate       : String
    JGPrintCopies     : Number

[Variable: JGPrintAlias]
    Type    : String
    Default : ""

[Variable: JGPrintItemName]
    Type    : String
    Default : ""

[Variable: JGPrintMRP]
    Type    : String
    Default : ""

[Variable: JGPrintRate]
    Type    : String
    Default : ""

[Variable: JGPrintCopies]
    Type    : Number
    Default : 1

;; ---- Stock Item master: Labels to Print (manual override) ----

[Part: JG SI Labels To Print Part]
    Lines    : JG SI Labels To Print Line
    Vertical : Yes

[Line: JG SI Labels To Print Line]
    Fields : JG SI Labels To Print Lbl, JG SI Labels To Print Fld

[Field: JG SI Labels To Print Lbl]
    Use    : Name Field
    Set As : "Labels to Print"
    Width  : 18
    Style  : Normal Bold
    Skip   : Yes

[Field: JG SI Labels To Print Fld]
    Use      : Number Field
    Storage  : JGLabelsToPrint
    Width    : 8
    Validate : ($$IsEmpty:$$Value) OR (($$Number:$$Value >= 1) AND ($$Number:$$Value <= 100))

[#Form: Stock Item]
    Add : Part    : JG SI Labels To Print Part
    Add : Buttons : JGPrintBarcodeBtn

[Button: JGPrintBarcodeBtn]
    Title  : "Print Barcode"
    Key    : Ctrl + Alt + B
    Action : Call : JGPrintBarcodeStart

;; ---- Shared payload loader (Stock Item reprint + Purchase) ----

[Function: JGClampPrintCopies]
    Parameter : pCopies : Number
    Variable  : N : Number
    01 : Set : N : $$Number:##pCopies
    02 : IF : ##N < 1
    03 :   Set : N : 1
    04 : ENDIF
    05 : IF : ##N > 100
    06 :   Set : N : 100
    07 : ENDIF
    08 : Set : JGPrintCopies : ##N
    09 : RETURN : ##N

[Function: JGLoadItemPrintPayload]
    ;; Load one Stock Item into print variables. pCopies = label count for Module 08.
    ;; Alias via JGPurcGetAlias (04) — Walk Collection + $$Alias (live-verified).
    Parameter : pItem : String
    Parameter : pCopies : Number
    Variable  : Code : String
    Variable  : Mrp  : String
    Variable  : Rate : String
    01 : IF : $$IsEmpty:##pItem
    02 :   RETURN : No
    03 : ENDIF
    04 : Call : JGPurcGetAlias : ##pItem
    05 : Set : Code : $$LastResult
    06 : IF : $$IsEmpty:##Code
    07 :   RETURN : No
    08 : ENDIF
    09 : Set : Mrp  : $$String:$MRPDetails[Last].MRPRateDetails[Last].MRPRate:StockItem:##pItem
    10 : Set : Rate : $$String:$StandardPrice:StockItem:##pItem
    11 : Set : JGPrintAlias    : ##Code
    12 : Set : JGPrintItemName : ##pItem
    13 : Set : JGPrintMRP      : ##Mrp
    14 : Set : JGPrintRate     : ##Rate
    15 : Call : JGClampPrintCopies : ##pCopies
    16 : RETURN : Yes

[Function: JGPrintBarcodeStart]
    ;; Stock Item master reprint — copies from UDF JGLabelsToPrint
    Variable : Code   : String
    Variable : Item   : String
    Variable : Copies : Number
    Variable : Mrp    : String
    Variable : Rate   : String
    01 : Set : Item : $Name
    02 : Set : Code : $$Alias
    03 : IF : $$IsEmpty:##Code
    04 :   MSG BOX : "Print Barcode" : "No barcode available for this Stock Item."
    05 :   RETURN
    06 : ENDIF
    07 : Set : Copies : $$Number:$JGLabelsToPrint
    08 : IF : ##Copies < 1
    09 :   Set : Copies : 1
    10 : ENDIF
    11 : Set : Mrp  : $$String:$MRPDetails[Last].MRPRateDetails[Last].MRPRate
    12 : Set : Rate : $$String:$StandardPrice
    13 : Set : JGPrintAlias    : ##Code
    14 : Set : JGPrintItemName : ##Item
    15 : Set : JGPrintMRP      : ##Mrp
    16 : Set : JGPrintRate     : ##Rate
    17 : Call : JGClampPrintCopies : ##Copies
    18 : Print Report : JGLabelReport
