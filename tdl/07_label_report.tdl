;; ============================================================================
;; 07_label_report.tdl — ONE complete sticker (column template)
;;
;; Content comes from the current JGLabelRows object methods
;; (A1/N1/M1/R1 …) when used as a sheet column, or from the flat
;; queue object ($Alias / $ItemName / $MRP / $Rate) when repeated
;; directly. Module 08 owns the A4 sheet + Repeat.
;; ============================================================================

[Style: JGLabelBarsStyle]
    Font   : "Libre Barcode 39"
    Height : 30

;; No Collection attribute here. A Report bound to a collection is generated
;; once per object in it, so the whole sheet repeated once per row (4 labels =
;; 2 rows = 2 pages, 50 labels = 17 rows = 34 pages). The rows are consumed by
;; the Repeat on JGSheetPart in Module 08 instead.
[Report: JGLabelReport]
    Title : "Barcode Label"
    Form  : JGLabelForm

[Form: JGLabelForm]
    Part : JGLabelPart

[Part: JGLabelPart]
    Lines    : JGLabelBarsLine, JGLabelAliasLine, JGLabelNameLine, JGLabelMrpLine, JGLabelRateLine
    Vertical : Yes

[Line: JGLabelBarsLine]
    Fields : JGLabelBarsFld

[Line: JGLabelAliasLine]
    Fields : JGLabelAliasFld

[Line: JGLabelNameLine]
    Fields : JGLabelNameFld

[Line: JGLabelMrpLine]
    Fields : JGLabelMrpFld

[Line: JGLabelRateLine]
    Fields : JGLabelRateFld

[Field: JGLabelBarsFld]
    Use    : Name Field
    Set As : "*" + ##JGPrintAlias + "*"
    Style  : JGLabelBarsStyle

[Field: JGLabelAliasFld]
    Use    : Name Field
    Set As : ##JGPrintAlias
    Style  : Tiny Bold
    Align  : Centre

[Field: JGLabelNameFld]
    Use    : Name Field
    ;; Manual p.46 example uses start index 0: $$StringPart(...):0:5
    Set As : $$StringPart:##JGPrintItemName:0:24
    Style  : Tiny
    Align  : Centre

[Field: JGLabelMrpFld]
    Use    : Name Field
    Set As : "MRP : " + ##JGPrintMRP
    Style  : Tiny
    Align  : Centre

[Field: JGLabelRateFld]
    Use    : Name Field
    Set As : "Rate : " + ##JGPrintRate
    Style  : Tiny
    Align  : Centre
