;; ============================================================================
;; Config.tdl — native add-on settings (no HTTP / no Node)
;; ============================================================================

[System: Formula]
    JGBarcodeEnabled     : "Yes"
    JGBarcodePrefix      : "JG"
    JGBarcodePadLength   : 8
    ;; Windows font name AFTER installing fonts/LibreBarcode128-Regular.ttf
    JGBarcodeFontName    : "Libre Barcode 128"
    JGBarcodeFontSize    : 28
    JGAskPrintOnPurchase : "Yes"

[System: Variable]
    JGPrintLabelsChoice  : Logical : No
    JGScanBuffer         : String
    JGWorkItem           : String
    JGWorkBarcode        : String
    JGWorkEncoded        : String
    JGWorkMfr            : String
    JGWorkBrand          : String
    JGWorkMrp            : Amount
    JGWorkSellRate       : Amount
    JGWorkQty            : Number
    JGLabelList          : String
    JGSeqTemp            : Number
    JGPadTemp            : String
    JGLoopIndex          : Number
    JGLoopChar           : String
    JGChecksum           : Number
    JGCodeValue          : Number
    JGEncodeOut          : String

[Variable: JGPrintLabelsChoice]
    Type    : Logical
    Default : No

[Variable: JGScanBuffer]
    Type    : String
    Default : ""

[Variable: JGWorkItem]
    Type    : String
    Default : ""

[Variable: JGWorkBarcode]
    Type    : String
    Default : ""

[Variable: JGWorkEncoded]
    Type    : String
    Default : ""

[Variable: JGWorkMfr]
    Type    : String
    Default : ""

[Variable: JGWorkBrand]
    Type    : String
    Default : ""

[Variable: JGWorkMrp]
    Type    : Amount
    Default : 0

[Variable: JGWorkSellRate]
    Type    : Amount
    Default : 0

[Variable: JGWorkQty]
    Type    : Number
    Default : 1

[Variable: JGLabelList]
    Type    : String
    Default : ""

[Variable: JGSeqTemp]
    Type    : Number
    Default : 1

[Variable: JGPadTemp]
    Type    : String
    Default : ""

[Variable: JGLoopIndex]
    Type    : Number
    Default : 0

[Variable: JGLoopChar]
    Type    : String
    Default : ""

[Variable: JGChecksum]
    Type    : Number
    Default : 0

[Variable: JGCodeValue]
    Type    : Number
    Default : 0

[Variable: JGEncodeOut]
    Type    : String
    Default : ""
