;; ============================================================================
;; 04_purchase.tdl — Purchase → Alias + on-demand label print
;;
;; On Purchase Form Accept:
;;   Walk Inventory Entries — ensure Alias (never overwrite). No printing,
;;   no prompt: saving a voucher must never interrupt the user.
;;
;; Printing is always explicit — Ctrl+Alt+B on the voucher (create or alter).
;;
;; Print pipeline (NO Print Report inside the item loop):
;;   1. Clear JGLabelQueue
;;   2. Walk Inventory Entries — enqueue each item by INNER PACK count
;;      (alternate / secondary qty, e.g. BOX), not primary pieces (PC).
;;      60 PC with 1 BOX = 6 PC → 10 labels.
;;   3. Pack rows + Print Report : JGLabelReport   ← exactly once
;;
;; Never JGLabelsToPrint, never a quantity prompt.
;; Label layout remains Modules 07/08 (3-col A4 over the queue).
;; ============================================================================

[System: Variable]
    JGAliasItemName      : String

[Variable: JGAliasItemName]
    Type    : String
    Default : ""

[Collection: JGStockItemByNameColl]
    Type   : Stock Item
    Filter : JGStockItemNameFilter

[System: Formula]
    JGStockItemNameFilter : $Name = ##JGAliasItemName

[Function: JGPurcGetAlias]
    Parameter : pItem : String
    Variable  : Code : String
    01 : IF : $$IsEmpty:##pItem
    02 :   RETURN : ""
    03 : ENDIF
    04 : Set : JGAliasItemName : ##pItem
    05 : Set : Code : ""
    06 : Walk Collection : JGStockItemByNameColl
    07 :   Set : Code : $$Alias
    08 : End Walk
    09 : RETURN : ##Code

[Function: JGPurcPad7]
    ;; Zero-pad to 7 digits → 0000001
    Parameter : pNum : Number
    Variable  : S : String
    Variable  : Need : Number
    01 : Set : S : $$String:##pNum
    02 : Set : Need : 7 - $$StringLength:##S
    03 : WHILE : ##Need > 0
    04 :   Set : S : "0" + ##S
    05 :   Set : Need : ##Need - 1
    06 : END WHILE
    07 : RETURN : ##S

[Function: JGPurcNextCode]
    ;; Company JGNextSeq → padded code; bump counter
    Variable : Seq : Number
    Variable : Code : String
    01 : Set : Seq : $$Number:$JGNextSeq:Company:##SVCurrentCompany
    02 : IF : $$IsEmpty:$JGNextSeq:Company:##SVCurrentCompany OR ##Seq < 1
    03 :   Set : Seq : 1
    04 : ENDIF
    05 : Call : JGPurcPad7 : ##Seq
    06 : Set : Code : $$LastResult
    07 : New Object : Company : ##SVCurrentCompany
    08 : Set Value  : JGNextSeq : ##Seq + 1
    09 : Accept Alter
    10 : RETURN : ##Code

[Function: JGPurcSetAliasIfEmpty]
    Parameter : pItem : String
    Variable  : Existing : String
    Variable  : Code : String
    01 : IF : $$IsEmpty:##pItem
    02 :   RETURN
    03 : ENDIF
    04 : Call : JGPurcGetAlias : ##pItem
    05 : Set : Existing : $$LastResult
    06 : IF : NOT $$IsEmpty:##Existing
    07 :   RETURN
    08 : ENDIF
    09 : Call : JGPurcNextCode
    10 : Set : Code : $$LastResult
    11 : New Object : Stock Item : ##pItem
    12 : Insert Collection Object : Name
    13 : Set Value : Name : ##Code
    14 : Accept Alter

[Function: JGPurcLabelCountFromLine]
    ;; Labels = alternate/secondary qty (BOX), not primary pieces (PC).
    ;; FAQ 6201: $$String:<Qty>:Secondary → qty in alternate units.
    ;; No alternate unit on the item → fall back to primary $$Number:$BilledQty.
    Variable : Pack : Number
    Variable : S    : String
    01 : Set : S : $$String:$BilledQty:Secondary
    02 : Set : Pack : $$Number:##S
    03 : IF : ##Pack < 1
    04 :   Set : Pack : $$Number:$BilledQty
    05 : ENDIF
    06 : IF : ##Pack < 1
    07 :   Set : Pack : 1
    08 : ENDIF
    09 : RETURN : ##Pack

[Function: JGPurcPrintLabelsFromQty]
    ;; Build the entire voucher label queue first, then print once.
    ;; Print Report is NEVER called inside the Inventory Entries walk.
    ;; One sticker per inner pack (BOX), not per piece (PC).
    Variable : ItemName : String
    Variable : Qty      : Number
    Variable : Lines    : Number
    Variable : Queued   : Number
    01 : Call : JGClearLabelQueue
    02 : Set : Lines  : 0
    03 : Set : Queued : 0
    04 : Walk Collection : Inventory Entries
    05 :   Set : ItemName : $StockItemName
    06 :   IF : NOT $$IsEmpty:##ItemName
    07 :     Set : Lines : ##Lines + 1
    08 :     Call : JGPurcLabelCountFromLine
    09 :     Set : Qty : $$LastResult
    10 :     Call : JGEnqueueItemLabels : ##ItemName : ##Qty
    11 :     IF : $$LastResult
    12 :       Set : Queued : ##Queued + 1
    13 :     ENDIF
    14 :   ENDIF
    15 : End Walk
    16 : IF : ##Lines < 1
    17 :   MSG BOX : "Print Barcode Labels" : "No inventory entries found in this voucher."
    18 :   RETURN : No
    19 : ENDIF
    20 : IF : ##Queued < 1 OR $$ListCount:JGLabelQueue < 1
    21 :   MSG BOX : "Print Barcode Labels" : "No item in this voucher has a barcode alias yet."
    22 :   RETURN : No
    23 : ENDIF
    24 : Call : JGPrintLabelQueue
    25 : RETURN : $$LastResult

[Function: JGPurcPrintLabelsButton]
    ;; Workflow 3 — saved Purchase Voucher opened in Alter/Display.
    01 : IF : NOT $$IsPurchase:$VoucherTypeName
    02 :   IF : NOT $$IsEqual:$VoucherTypeName:"Purchase"
    03 :     MSG BOX : "Print Barcode Labels" : "This voucher is not a Purchase voucher."
    04 :     RETURN : No
    05 :   ENDIF
    06 : ENDIF
    07 : Call : JGPurcPrintLabelsFromQty
    08 : RETURN : $$LastResult

[Function: JGPurcOnAccept]
    Variable : ItemName : String
    01 : IF : NOT $$IsPurchase:$VoucherTypeName
    02 :   IF : NOT $$IsEqual:$VoucherTypeName:"Purchase"
    03 :     RETURN : Yes
    04 :   ENDIF
    05 : ENDIF
    06 : Walk Collection : Inventory Entries
    07 :   Set : ItemName : $StockItemName
    08 :   IF : NOT $$IsEmpty:##ItemName
    09 :     Call : JGPurcSetAliasIfEmpty : ##ItemName
    10 :   ENDIF
    11 : End Walk
    12 : RETURN : Yes

[#Form: Voucher]
    On      : Form Accept : Yes : Call : JGPurcOnAccept
    Add     : Buttons : JGPurcPrintLabelsBtn

[Button: JGPurcPrintLabelsBtn]
    Title  : "Print Barcode Labels"
    Key    : Ctrl + Alt + B
    Action : Call : JGPurcPrintLabelsButton
