;; ============================================================================
;; 04_purchase.tdl — Purchase → Alias + optional label print
;;
;; On Purchase Form Accept:
;;   1. Walk Inventory Entries — ensure Alias (never overwrite)
;;   2. Query Box: Print Barcode Labels?
;;   3. If Yes: for each inventory line, Print Report : JGLabelReport
;;      with ##JGPrintCopies = BilledQty (one label per unit received)
;;
;; Label layout remains Modules 07/08 (fixed 3-col A4).
;; Stock Item master "Labels to Print" is for reprint only (Module 06).
;; ============================================================================

[System: Variable]
    JGAliasItemName      : String
    JGPrintLabelsChoice  : Logical

[Variable: JGAliasItemName]
    Type    : String
    Default : ""

[Variable: JGPrintLabelsChoice]
    Type    : Logical
    Default : No

[Collection: JGStockItemByNameColl]
    Type   : Stock Item
    Filter : JGStockItemNameFilter

[System: Formula]
    JGStockItemNameFilter : $Name = ##JGAliasItemName

[Function: JGPurcGetAlias]
    Parameter : pItem : String
    Variable  : Code : String
    01 : IF : $$IsEmpty:##pItem
    02 :   RETURN : ""
    03 : ENDIF
    04 : Set : JGAliasItemName : ##pItem
    05 : Set : Code : ""
    06 : Walk Collection : JGStockItemByNameColl
    07 :   Set : Code : $$Alias
    08 : End Walk
    09 : RETURN : ##Code

[Function: JGPurcPad7]
    ;; Zero-pad to 7 digits → 0000001
    Parameter : pNum : Number
    Variable  : S : String
    Variable  : Need : Number
    01 : Set : S : $$String:##pNum
    02 : Set : Need : 7 - $$StringLength:##S
    03 : WHILE : ##Need > 0
    04 :   Set : S : "0" + ##S
    05 :   Set : Need : ##Need - 1
    06 : END WHILE
    07 : RETURN : ##S

[Function: JGPurcNextCode]
    ;; Company JGNextSeq → padded code; bump counter
    Variable : Seq : Number
    Variable : Code : String
    01 : Set : Seq : $$Number:$JGNextSeq:Company:##SVCurrentCompany
    02 : IF : $$IsEmpty:$JGNextSeq:Company:##SVCurrentCompany OR ##Seq < 1
    03 :   Set : Seq : 1
    04 : ENDIF
    05 : Call : JGPurcPad7 : ##Seq
    06 : Set : Code : $$LastResult
    07 : New Object : Company : ##SVCurrentCompany
    08 : Set Value  : JGNextSeq : ##Seq + 1
    09 : Accept Alter
    10 : RETURN : ##Code

[Function: JGPurcSetAliasIfEmpty]
    Parameter : pItem : String
    Variable  : Existing : String
    Variable  : Code : String
    01 : IF : $$IsEmpty:##pItem
    02 :   RETURN
    03 : ENDIF
    04 : Call : JGPurcGetAlias : ##pItem
    05 : Set : Existing : $$LastResult
    06 : IF : NOT $$IsEmpty:##Existing
    07 :   RETURN
    08 : ENDIF
    09 : Call : JGPurcNextCode
    10 : Set : Code : $$LastResult
    11 : New Object : Stock Item : ##pItem
    12 : Insert Collection Object : Name
    13 : Set Value : Name : ##Code
    14 : Accept Alter

[Function: JGPurcPrintLabelsFromQty]
    ;; One Print Report per inventory line; copies = BilledQty (clamped in 06).
    Variable : ItemName : String
    Variable : Qty      : Number
    01 : Walk Collection : Inventory Entries
    02 :   Set : ItemName : $StockItemName
    03 :   IF : NOT $$IsEmpty:##ItemName
    04 :     Set : Qty : $$Number:$BilledQty
    05 :     IF : ##Qty < 1
    06 :       Set : Qty : 1
    07 :     ENDIF
    08 :     Call : JGLoadItemPrintPayload : ##ItemName : ##Qty
    09 :     IF : $$LastResult
    10 :       Print Report : JGLabelReport
    11 :     ENDIF
    12 :   ENDIF
    13 : End Walk

[Function: JGPurcOnAccept]
    Variable : ItemName : String
    01 : IF : NOT $$IsPurchase:$VoucherTypeName
    02 :   IF : NOT $$IsEqual:$VoucherTypeName:"Purchase"
    03 :     RETURN : Yes
    04 :   ENDIF
    05 : ENDIF
    06 : Walk Collection : Inventory Entries
    07 :   Set : ItemName : $StockItemName
    08 :   IF : NOT $$IsEmpty:##ItemName
    09 :     Call : JGPurcSetAliasIfEmpty : ##ItemName
    10 :   ENDIF
    11 : End Walk
    12 : Set : JGPrintLabelsChoice : No
    13 : Query Box : "Print Barcode Labels?" : JGPrintLabelsChoice
    14 : IF : ##JGPrintLabelsChoice
    15 :   Call : JGPurcPrintLabelsFromQty
    16 : ENDIF
    17 : RETURN : Yes

[#Form: Voucher]
    On : Form Accept : Yes : Call : JGPurcOnAccept
