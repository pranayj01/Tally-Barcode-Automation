# Server
PORT=3100
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Barcode sequence
BARCODE_PREFIX=JG
BARCODE_PAD_LENGTH=8
BARCODE_START_SEQUENCE=1

# Storage
DATABASE_PATH=./data/barcodes.db
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Printing
# Modes: pdf | windows | zebra | tsc | xprinter | tvs | auto
DEFAULT_PRINT_MODE=pdf
DEFAULT_PRINTER_NAME=
# TCP raw for Zebra/TSC network printers (optional)
PRINTER_HOST=
PRINTER_PORT=9100

# Label geometry (mm)
LABEL_WIDTH_MM=50
LABEL_HEIGHT_MM=25
LABEL_DPI=203
